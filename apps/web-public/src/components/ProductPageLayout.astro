---
interface Props {
  productName: string;
  headline: string;
  subheadline: string;
  problemItems: string[];
  howItWorksItems: string[];
  architectureItems: string[];
  audienceItems: string[];
  roadmapCurrent: string;
  roadmapNext: string;
  ctaPrimaryLabel: string;
  ctaPrimaryHref: string;
  ctaSecondaryLabel: string;
  ctaSecondaryHref: string;
}

const {
  productName,
  headline,
  subheadline,
  problemItems,
  howItWorksItems,
  architectureItems,
  audienceItems,
  roadmapCurrent,
  roadmapNext,
  ctaPrimaryLabel,
  ctaPrimaryHref,
  ctaSecondaryLabel,
  ctaSecondaryHref,
} = Astro.props;
---

<section class="product-hero content-card">
  <h1>{productName}</h1>
  <p class="product-headline">{headline}</p>
  <p>{subheadline}</p>
</section>

<section class="content-card">
  <h2>Problema do setor</h2>
  <ul>
    {problemItems.map((item) => <li>{item}</li>)}
  </ul>
</section>

<section class="content-card">
  <h2>Como funciona</h2>
  <ul>
    {howItWorksItems.map((item) => <li>{item}</li>)}
  </ul>
</section>

<section class="content-card">
  <h2>Diferencial arquitetural</h2>
  <ul>
    {architectureItems.map((item) => <li>{item}</li>)}
  </ul>
</section>

<section class="content-card">
  <h2>Público atendido</h2>
  <ul>
    {audienceItems.map((item) => <li>{item}</li>)}
  </ul>
</section>

<section class="content-card">
  <h2>Roadmap</h2>
  <p><strong>Fase atual:</strong> {roadmapCurrent}</p>
  <p><strong>Próxima fase:</strong> {roadmapNext}</p>
</section>

<section class="content-card product-cta-final">
  <h2>Próximo passo</h2>
  <div class="product-actions">
    <a class="hero-cta-secondary" href={ctaPrimaryHref}>{ctaPrimaryLabel}</a>
    <a class="hero-cta-primary" href={ctaSecondaryHref}>{ctaSecondaryLabel}</a>
  </div>
</section>
