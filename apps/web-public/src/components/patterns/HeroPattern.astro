---
interface Props {
  title: string;
  description: string;
  primaryCtaLabel: string;
  primaryCtaHref: string;
  secondaryCtaLabel: string;
  secondaryCtaHref: string;
}

const {
  title,
  description,
  primaryCtaLabel,
  primaryCtaHref,
  secondaryCtaLabel,
  secondaryCtaHref,
} = Astro.props as Props;
---

<section class="pf-container pf-container--lg home-section">
  <section class="pf-card pf-surface-card home-hero">
    <h1 class="pf-typography pf-typography--h1">{title}</h1>
    <p class="pf-typography pf-typography--body home-lead">{description}</p>
    <div class="home-cta-row">
      <a
        href={primaryCtaHref}
        class="pf-button pf-button--primary pf-button--md"
        aria-label={primaryCtaLabel}
      >
        {primaryCtaLabel}
      </a>
      <a
        href={secondaryCtaHref}
        class="pf-button pf-button--secondary pf-button--md"
        aria-label={secondaryCtaLabel}
      >
        {secondaryCtaLabel}
      </a>
    </div>
  </section>
</section>
