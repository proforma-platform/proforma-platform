---
interface LinkItem {
  label: string;
  href: string;
}

interface Props {
  title: string;
  links: LinkItem[];
}

const { title, links } = Astro.props as Props;
---

<section class="pf-container pf-container--lg home-section">
  <section class="pf-card pf-surface-card home-trust-nav">
    <h2 class="pf-typography pf-typography--h3">{title}</h2>
    <nav aria-label="Navegação institucional">
      <ul class="home-trust-links">
        {
          links.map((link) => (
            <li><a href={link.href} class="home-inline-link">{link.label}</a></li>
          ))
        }
      </ul>
    </nav>
  </section>
</section>
