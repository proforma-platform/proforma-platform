---
interface TrustItem {
  title: string;
  description: string;
}

interface Props {
  title: string;
  items: TrustItem[];
}

const { title, items } = Astro.props as Props;
---

<section class="pf-container pf-container--lg home-section" aria-label="Trust and compliance">
  <h2 class="pf-typography pf-typography--h2">{title}</h2>
  <div class="home-trust-grid">
    {
      items.map((item) => (
        <article class="pf-card pf-surface-card home-trust-card">
          <div class="home-trust-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="20" height="20" role="img" focusable="false">
              <path d="M12 3l8 3v6c0 5-3.4 8.7-8 10-4.6-1.3-8-5-8-10V6l8-3z" fill="currentColor"></path>
            </svg>
          </div>
          <h3 class="pf-typography pf-typography--h3">{item.title}</h3>
          <p class="pf-typography pf-typography--body">{item.description}</p>
        </article>
      ))
    }
  </div>
</section>
