---
interface Item {
  name: string;
  description: string;
  href: string;
  accent: "farm" | "medcore";
}

interface Props {
  id?: string;
  title: string;
  description: string;
  items: Item[];
}

const { id = "solucoes", title, description, items } = Astro.props as Props;
---

<section class="pf-container pf-container--lg home-section" id={id}>
  <h2 class="pf-typography pf-typography--h2">{title}</h2>
  <p class="pf-typography pf-typography--body home-section-text">{description}</p>

  <div class="home-product-grid">
    {
      items.map((item) => (
        <section class={`pf-card pf-surface-card home-product-card home-product-card--${item.accent}`}>
          <h3 class="pf-typography pf-typography--h3">{item.name}</h3>
          <p class="pf-typography pf-typography--body">{item.description}</p>
          <a href={item.href} class="home-inline-link">Acessar produto</a>
        </section>
      ))
    }
  </div>
</section>
