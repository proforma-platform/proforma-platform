---
interface Props {
  title: string;
  description: string;
  ctaLabel: string;
  ctaHref: string;
}

const { title, description, ctaLabel, ctaHref } = Astro.props as Props;
---

<section class="pf-container pf-container--lg home-section">
  <section class="pf-card pf-surface-card home-cta-block">
    <h2 class="pf-typography pf-typography--h2">{title}</h2>
    <p class="pf-typography pf-typography--body home-section-text">{description}</p>
    <a href={ctaHref} class="pf-button pf-button--primary pf-button--lg" aria-label={ctaLabel}>
      {ctaLabel}
    </a>
  </section>
</section>
