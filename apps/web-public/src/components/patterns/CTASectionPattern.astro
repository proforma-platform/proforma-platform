---
import { createElement } from "react";
import { renderToStaticMarkup } from "react-dom/server";
import { Button, Card, Container, Typography } from "@proforma/design-system";

interface Props {
  title: string;
  description: string;
  ctaLabel: string;
  ctaHref: string;
}

const { title, description, ctaLabel, ctaHref } = Astro.props as Props;

const ctaHtml = renderToStaticMarkup(
  createElement(
    Container,
    { as: "section", maxWidth: "lg", className: "home-section" },
    createElement(
      Card,
      { className: "home-cta-block" },
      createElement(Typography, { variant: "h2", as: "h2" }, title),
      createElement(Typography, { variant: "body", as: "p", className: "home-section-text" }, description),
      createElement(
        "form",
        { action: ctaHref, method: "get", className: "home-cta-form" },
        createElement(
          Button,
          { type: "submit", variant: "primary", size: "lg", "aria-label": ctaLabel },
          ctaLabel
        )
      )
    )
  )
);
---

<Fragment set:html={ctaHtml} />
