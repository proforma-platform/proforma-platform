---
interface IntegrationItem {
  title: string;
  description: string;
}

interface Props {
  title: string;
  description: string;
  items: IntegrationItem[];
  ctaLabel: string;
  ctaHref: string;
}

const { title, description, items, ctaLabel, ctaHref } = Astro.props as Props;
---

<section class="pf-container pf-container--lg home-section" aria-label="Integrações e ecossistema">
  <h2 class="pf-typography pf-typography--h2">{title}</h2>
  <p class="pf-typography pf-typography--body home-section-text">{description}</p>

  <div class="home-integrations-grid">
    {
      items.map((item) => (
        <article class="pf-card pf-surface-card home-integration-card">
          <div class="home-integration-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="20" height="20" role="img" focusable="false">
              <rect x="4" y="4" width="6" height="6" rx="1.5" fill="currentColor"></rect>
              <rect x="14" y="4" width="6" height="6" rx="1.5" fill="currentColor"></rect>
              <rect x="4" y="14" width="6" height="6" rx="1.5" fill="currentColor"></rect>
              <rect x="14" y="14" width="6" height="6" rx="1.5" fill="currentColor"></rect>
            </svg>
          </div>
          <h3 class="pf-typography pf-typography--h3">{item.title}</h3>
          <p class="pf-typography pf-typography--body">{item.description}</p>
        </article>
      ))
    }
  </div>

  <div class="home-integrations-cta">
    <a href={ctaHref} class="pf-button pf-button--secondary pf-button--md">{ctaLabel}</a>
  </div>
</section>
