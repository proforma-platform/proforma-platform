---
import CTASectionPattern from "./patterns/CTASectionPattern.astro";
import FooterPattern from "./patterns/FooterPattern.astro";
import ProductHeroPattern from "./patterns/ProductHeroPattern.astro";
import ProductHighlightsPattern from "./patterns/ProductHighlightsPattern.astro";
import type { Product } from "../products/types";

interface Props {
  product: Product;
}

const { product } = Astro.props as Props;
const accent = product.slug === "proformafarm" ? "farm" : "medcore";
const primaryCta = product.ctas[0] ?? { label: "Falar com Especialista", href: "/contato" };
const secondaryCta = product.ctas[1];
---

<ProductHeroPattern
  name={product.name}
  title={product.tagline}
  description={product.description}
  accent={accent}
  primaryCta={{ label: primaryCta.label, href: primaryCta.href }}
  secondaryCta={secondaryCta ? { label: secondaryCta.label, href: secondaryCta.href } : undefined}
/>

<ProductHighlightsPattern
  featuresTitle="Benefícios estratégicos"
  modulesTitle="Como funciona na prática"
  features={product.features}
  modules={product.modules}
/>

<CTASectionPattern
  title={`Avalie ${product.name} com foco em resultado operacional`}
  description="Converse com o time Proforma para mapear prioridades, riscos e ganhos da implementação."
  ctaLabel={primaryCta.label}
  ctaHref={primaryCta.href}
/>

<FooterPattern
  title="Explore também"
  links={[
    { label: "Plataforma", href: "/" },
    { label: "Arquitetura", href: "/arquitetura" },
    { label: "Segurança", href: "/seguranca" },
    { label: "Contato", href: "/contato" },
  ]}
/>
