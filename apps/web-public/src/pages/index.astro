  },
  {
    title: "Integrações sob demanda",
    description: "Camada evolutiva para incorporar sistemas críticos conforme prioridade de negócio.",
  },
];

const caseStudiesItems = [
  {
    scenario: "Exemplo de cenário: operação farmacêutica com processos distribuídos e baixa visibilidade de riscos.",
    intervention: "Resultados típicos após intervenção: consolidação de dados operacionais e trilhas auditáveis por unidade.",
    expectedImpact:
      "Impacto esperado: redução de retrabalho e maior previsibilidade para decisões de estoque e conformidade.",
  },
  {
    scenario: "Exemplo de cenário: rede clínica em expansão com alto volume assistencial e controles heterogêneos.",
    intervention: "Resultados típicos após intervenção: padronização de fluxo, governança de eventos e indicadores comuns.",
    expectedImpact:
      "Impacto esperado: consistência operacional e ganho progressivo de capacidade analítica para escalar serviços.",
