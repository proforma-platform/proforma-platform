---

<PublicLayout
  title="Plataforma institucional"
  description="Proforma Platform: segurança, conformidade e escala para produtos SaaS multi-setor."
>
  <HeroPattern
    title="Uma plataforma que conecta operação, dados e governança."
    description="Proforma Platform integra produtos SaaS sob uma arquitetura moderna, com foco em performance, segurança e maturidade operacional."
    primaryCtaLabel="Falar com Especialista"
    primaryCtaHref="/contato"
    secondaryCtaLabel="Ver Soluções"
    secondaryCtaHref="#solucoes"
  />

  <ProductSwitcherPattern
    id="solucoes"
    title="Soluções para operação farmacêutica e clínica"
    description="Cada produto foi desenhado para resolver dores específicas, mantendo linguagem de plataforma única."
    items={productItems}
  />

  <FeatureGridPattern
    title="Capacidades compartilhadas da plataforma"
    items={featureItems}
  />

  <SocialProofPattern
    title="Resultados percebidos por operações reais"
    description="Estrutura pronta para social proof enterprise com métricas e contexto de impacto."
    items={socialProofItems}
  />

  <TrustCompliancePattern title="Trust & Compliance" items={trustItems} />

  <IntegrationsPattern
    title="Integrações e ecossistema"
    description="A plataforma está preparada para evoluir integrações com sistemas corporativos sem prometer conectores prontos fora do escopo atual."
    items={integrationItems}
    ctaLabel="Falar sobre integrações"
    ctaHref="/contato"
  />

  <CaseStudiesPattern
    title="Case studies estruturados para evolução"
    description="Base pronta para publicar casos com métricas reais quando houver evidência validada."
    items={caseStudiesItems}
  />

  <CTASectionPattern
    title="Pronto para evoluir sua operação com base sólida?"
    description="Converse com o time Proforma para mapear prioridades e estruturar o próximo ciclo de crescimento."
    ctaLabel="Entrar em Contato"
    ctaHref="/contato"
  />

  <FooterPattern
    title="Navegação adicional"
    logoLabel="Proforma Platform"
    description="Plataforma institucional para operação, dados e governança no contexto enterprise de saúde e farmacêutico."
    products={[
      { label: "ProformaFarm", href: "/proformafarm/" },
      { label: "MedCore", href: "/medcore/" },
    ]}
    companyLinks={[
      { label: "Segurança", href: "/seguranca" },
      { label: "Arquitetura", href: "/arquitetura" },
      { label: "Evolução", href: "/evolucao" },
      { label: "Contato", href: "/contato" },
    ]}
    links={[]}
    legal={{
      cnpj: "CNPJ: 00.000.000/0000-00",
      address: "Endereço: <ENDERECO_EMPRESA>",
      copyright: "© 2026 Proforma Platform",
    }}
  />
</PublicLayout>
