    problemItems={[
      "Fragmentação de dados",
      "Processos manuais",
      "Falta de integração",
      "Baixa rastreabilidade",
      "Limitação de crescimento",
    ]}
    howItWorksItems={[
      "Centralização de dados clínicos",
      "Processos auditáveis",
      "Integração preparada",
      "Base modular",
    ]}
    architectureItems={[
      "Arquitetura modular",
      "Governança de backend",
      "Versionamento disciplinado",
      "Preparação para escala",
      "Segurança estruturada",
    ]}
    audienceItems={[
      "Clínicas médicas",
      "Clínicas odontológicas",
      "Estruturas em expansão",
    ]}
    roadmapCurrent="Estruturação conceitual"
    roadmapNext="Módulos clínicos centrais e integrações operacionais"
