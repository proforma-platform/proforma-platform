---
import ProductPageLayout from "../../components/ProductPageLayout.astro";
import PublicLayout from "../../layouts/PublicLayout.astro";
---

<PublicLayout
  title="MedCore"
  description="Plataforma clínica com governança de dados e estrutura preparada para escalar."
>
