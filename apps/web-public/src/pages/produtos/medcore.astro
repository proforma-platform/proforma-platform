---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { buildCanonicalUrl } from "../../lib/seo";

const targetPath = "/medcore/";
const canonical = buildCanonicalUrl({ site: Astro.site, path: targetPath });
---

<BaseLayout
  title="MedCore"
  description="Página antiga de MedCore. Use a rota oficial em /medcore/."
  canonical={canonical}
  robots="noindex,follow"
>
  <Fragment slot="head">
    <meta http-equiv="refresh" content={`0;url=${targetPath}`} />
  </Fragment>
  <section class="content-card">
    <h1>Conteúdo movido</h1>
    <p>
      A página de MedCore foi migrada para a rota principal.
      Continue em <a href={targetPath}>{targetPath}</a>.
    </p>
  </section>
</BaseLayout>
