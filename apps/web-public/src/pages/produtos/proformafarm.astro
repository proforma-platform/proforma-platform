---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { buildCanonicalUrl } from "../../lib/seo";

const targetPath = "/proformafarm";
const canonical = buildCanonicalUrl({ site: Astro.site, path: targetPath });
---

<BaseLayout
  title="ProformaFarm ERP"
  description="Página antiga de ProformaFarm. Use a rota oficial em /proformafarm."
  canonical={canonical}
  robots="noindex,follow"
>
  <Fragment slot="head">
    <meta http-equiv="refresh" content={`0;url=${targetPath}`} />
  </Fragment>
  <section class="content-card">
    <h1>Conteúdo movido</h1>
    <p>
      A página de ProformaFarm foi migrada para a rota principal.
      Continue em <a href={targetPath}>{targetPath}</a>.
    </p>
  </section>
</BaseLayout>
