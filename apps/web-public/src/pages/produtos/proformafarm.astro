---
import ProductPageLayout from "../../components/ProductPageLayout.astro";
import PublicLayout from "../../layouts/PublicLayout.astro";
---

<PublicLayout
  title="ProformaFarm"
  description="ERP farmacêutico com controle operacional real e arquitetura preparada para escalar."
>
  <ProductPageLayout
    productName="ProformaFarm"
    headline="ERP farmacêutico com controle operacional real e arquitetura preparada para escalar."
    subheadline="Especializado para farmácias, redes e distribuidores, o ProformaFarm combina controle de dados, rastreabilidade e governança estrutural em uma base tecnológica moderna."
    problemItems={[
      "Controle de lote e validade",
      "Complexidade tributária",
      "Margens reduzidas",
      "Integração fiscal",
      "Risco operacional",
    ]}
    howItWorksItems={[
      "Operação estruturada",
      "Controle de dados",
      "Conformidade fiscal",
      "Governança modular",
    ]}
    architectureItems={[
      "Arquitetura modular",
      "Governança de backend",
      "Versionamento disciplinado",
      "Separação de responsabilidades",
      "Base preparada para escala",
    ]}
    audienceItems={[
      "Farmácias independentes",
      "Redes regionais",
      "Distribuidores",
    ]}
    roadmapCurrent="Consolidação estrutural"
    roadmapNext="Integrações fiscais ampliadas e módulos complementares"
    ctaPrimaryLabel="Conhecer a arquitetura"
    ctaPrimaryHref="/arquitetura"
    ctaSecondaryLabel="Solicitar demonstração"
    ctaSecondaryHref="/contato"
  />
</PublicLayout>
