      <li>Comercial: <a href="mailto:vendas@proforma.local">vendas@proforma.local</a></li>
      <li>Institucional: <a href="mailto:contato@proforma.local">contato@proforma.local</a></li>
      <li>Portal de clientes: <a href="http://localhost:3000/portal">/portal</a></li>
    </ul>
  </section>
</PublicLayout>
