---
import "../styles/site.css";
import "@proforma/ui/help-launcher.css";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  enableHelpLauncher?: boolean;
}

const {
  title,
  description,
  ogImage = "/brand/mark.svg",
  enableHelpLauncher = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, "https://proforma.net.br").toString();
const pageTitle = `${title} | Proforma Platform`;
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>

    <link rel="icon" type="image/svg+xml" href="/brand/mark.svg" />
    <link rel="apple-touch-icon" href="/brand/mark.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Proforma Platform" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
  </head>
  <body>
    <header class="site-header">
      <div class="container site-header-inner">
        <a class="brand-home" href="/" aria-label="Proforma Platform">
          <img src="/brand/logo.svg" alt="Proforma" width="160" height="40" />
        </a>

        <nav class="site-nav site-nav-desktop" aria-label="Navegação principal">
          <a href="/">Plataforma</a>
          <a href="/produtos">Produtos</a>
          <a href="/produtos/proformafarm">ProformaFarm</a>
          <a href="/produtos/medcore">MedCore</a>
          <a href="/sobre">Sobre</a>
          <a href="/seguranca">Segurança</a>
          <a href="/compliance">Compliance</a>
          <a href="/contato">Contato</a>
        </nav>

        <a class="site-cta site-cta-desktop" href="/">Explorar a Plataforma</a>

        <details class="site-nav-mobile">
          <summary aria-label="Abrir menu principal">Menu</summary>
          <nav aria-label="Navegação principal mobile">
            <a href="/">Plataforma</a>
            <a href="/produtos">Produtos</a>
            <a href="/produtos/proformafarm">ProformaFarm</a>
            <a href="/produtos/medcore">MedCore</a>
            <a href="/sobre">Sobre</a>
            <a href="/seguranca">Segurança</a>
            <a href="/compliance">Compliance</a>
            <a href="/contato">Contato</a>
            <a class="site-cta" href="/">Explorar a Plataforma</a>
          </nav>
        </details>
      </div>
    </header>

    <main>
      <div class="container">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>© {new Date().getFullYear()} Proforma Platform</p>
      </div>
    </footer>

    {
      enableHelpLauncher && (
        <script type="module">
          import {
            getPublicHelpConfig,
            initHelpLauncher,
          } from "@proforma/ui/help-launcher";

          initHelpLauncher(getPublicHelpConfig());
        </script>
      )
    }
  </body>
</html>
