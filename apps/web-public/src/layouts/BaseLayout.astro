---
import "../styles/site.css";
import "@proforma/ui/help-launcher.css";
import BrandHeader from "../components/brand/BrandHeader.astro";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  enableHelpLauncher?: boolean;
}

const {
  title,
  description,
  ogImage = "/brand/mark.svg",
  enableHelpLauncher = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, "https://proforma.net.br").toString();
const pageTitle = `${title} | Proforma Platform`;
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>

    <link rel="icon" type="image/svg+xml" href="/brand/mark.svg" />
    <link rel="apple-touch-icon" href="/brand/mark.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Proforma Platform" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
  </head>
  <body>
    <BrandHeader />
    <main>
      <div class="container">
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="container">
        <p>© {new Date().getFullYear()} Proforma Platform</p>
      </div>
    </footer>
    {
      enableHelpLauncher && (
        <script type="module">
          import {
            getPublicHelpConfig,
            initHelpLauncher,
          } from "@proforma/ui/help-launcher";

          initHelpLauncher(getPublicHelpConfig());
        </script>
      )
    }
  </body>
</html>
