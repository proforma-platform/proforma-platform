---
import "../styles/site.css";
import "@proforma/ui/help-launcher.css";
import { buildCanonicalUrl, buildMetaTags } from "../lib/seo";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonical?: string;
  robots?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  enableHelpLauncher?: boolean;
}

const {
  title,
  description,
  ogImage = "/brand/mark.svg",
  canonical,
  robots,
  jsonLd,
  enableHelpLauncher = false,
} = Astro.props;

const pageTitle = `${title} | Proforma Platform`;
const canonicalUrl =
  canonical ?? buildCanonicalUrl({ site: Astro.site, path: Astro.url.pathname });
const meta = buildMetaTags({
  title: pageTitle,
  description,
  canonical: canonicalUrl,
  ogImage,
});
const jsonLdEntries = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={meta.description} />
    <title>{meta.title}</title>
    <link rel="canonical" href={meta.canonical} />
    {robots && <meta name="robots" content={robots} />}

    <link rel="icon" type="image/svg+xml" href="/brand/mark.svg" />
    <link rel="apple-touch-icon" href="/brand/mark.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Proforma Platform" />
    <meta property="og:title" content={meta.og.title} />
    <meta property="og:description" content={meta.og.description} />
    <meta property="og:image" content={meta.og.image} />
    <meta property="og:url" content={meta.og.url} />

    <meta name="twitter:card" content={meta.twitter.card} />
    <meta name="twitter:title" content={meta.twitter.title} />
    <meta name="twitter:description" content={meta.twitter.description} />
    <meta name="twitter:image" content={meta.twitter.image} />

    {
      jsonLdEntries.map((entry) => (
        <script type="application/ld+json" set:html={JSON.stringify(entry)} />
      ))
    }
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <div class="container site-header-inner">
        <a class="brand-home" href="/" aria-label="Proforma - início">
          <img src="/brand/logo.svg" alt="Proforma" width="160" height="40" />
        </a>
        <nav class="site-nav" aria-label="Navegação principal">
          <a href="/">Início</a>
          <a href="/produtos">Produtos</a>
          <a href="/seguranca">Segurança</a>
          <a href="/arquitetura">Arquitetura</a>
          <a href="/evolucao">Evolução</a>
          <a href="/contato">Contato</a>
        </nav>
      </div>
    </header>
    <main>
      <div class="container">
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="container">
        <p>© {new Date().getFullYear()} Proforma Platform</p>
      </div>
    </footer>
    {
      enableHelpLauncher && (
        <script type="module">
          import {
            getPublicHelpConfig,
            initHelpLauncher,
          } from "@proforma/ui/help-launcher";

          initHelpLauncher(getPublicHelpConfig());
        </script>
      )
    }
  </body>
</html>
