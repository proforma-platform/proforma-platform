---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  enableHelpLauncher?: boolean;
}

const { title, description, ogImage, enableHelpLauncher = false } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  ogImage={ogImage}
  enableHelpLauncher={enableHelpLauncher}
>
  <slot />
</BaseLayout>
