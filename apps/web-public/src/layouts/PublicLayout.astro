---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonical?: string;
  robots?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  enableHelpLauncher?: boolean;
}

const {
  title,
  description,
  ogImage,
  canonical,
  robots,
  jsonLd,
  enableHelpLauncher = false,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  ogImage={ogImage}
  canonical={canonical}
  robots={robots}
  jsonLd={jsonLd}
  enableHelpLauncher={enableHelpLauncher}
>
  <slot />
</BaseLayout>
