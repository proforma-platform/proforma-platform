        260
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseCode": 200,
        "responseBody": "={{$json}}"
      },
      "id": "Respond_MemoryStarter",
      "name": "Respond Memory Starter",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        760,
