        "jsonBody": "={{ { action: 'starter', query: $json.body?.query || $json.query, namespace: $json.body?.namespace || $json.namespace, mission_id: $json.body?.mission_id || $json.mission_id, role: $json.body?.role || $json.role, tags: $json.body?.tags || $json.tags, limit: $json.body?.limit || $json.limit || 5 } }}"
      },
