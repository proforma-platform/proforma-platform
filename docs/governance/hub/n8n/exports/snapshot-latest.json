      {
        "parameters": {
          "respondWith": "json",
          "responseCode": 200,
          "responseBody": "={{ { status: 'ok', snapshot_type: $json.snapshot_type, protocol: $json.protocol, version: $json.version, encoding: $json.encoding, compression: $json.compression, payload_b64: $json.payload_b64, payload_sha256: $json.payload_sha256, payload_size_bytes: Number($json.payload_size_bytes), created_at_utc: $json.created_at_utc, created_by: $json.created_by, source_repo: $json.source_repo, source_ref: $json.source_ref } }}"
        },
        "id": "Respond_SnapshotLatestOk",
        "name": "Respond Snapshot Latest OK",
        "type": "n8n-nodes-base.respondToWebhook",
        "typeVersion": 1,
