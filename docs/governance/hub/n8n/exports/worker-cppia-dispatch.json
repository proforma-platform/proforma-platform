        "parameters": {
          "mode": "runOnceForAllItems",
          "jsCode": "const headers = $json.headers ?? {};\nconst tokenHeader = String(headers['x-govhub-token'] || headers['X-GOVHUB-TOKEN'] || '').trim();\nconst allowed = String($env.GOVHUB_TOKENS || '').split(',').map(v => v.trim()).filter(Boolean);\nif (!tokenHeader || !allowed.includes(tokenHeader)) {\n  return [{ json: { ok: false, statusCode: 401, error_code: 'AUTH_INVALID_TOKEN', message: 'invalid token' } }];\n}\nconst asObj = (v) => (v && typeof v === 'object' && !Array.isArray(v) ? v : {});\nlet body = asObj($json.body);\nif (!Object.keys(body).length && typeof $json.body === 'string') {\n  try { body = asObj(JSON.parse($json.body)); } catch {}\n}\nif (!Object.keys(body).length) body = asObj($json);\nconst mission_id = String(body.mission_id || '').trim();\nconst task_id = String(body.task_id || '').trim();\nconst udn_block = String(body.udn_block || '').trim();\nconst git_ops = asObj(body.git_ops);\nif (!mission_id) {\n  return [{ json: { ok: false, statusCode: 400, error_code: 'DISPATCH_INVALID', message: 'mission_id is required' } }];\n}\nreturn [{ json: { ok: true, mission_id, task_id, udn_block, ...(Object.keys(git_ops).length ? { git_ops } : {}) } }];"
        },
        "id": "Code_Validate",
