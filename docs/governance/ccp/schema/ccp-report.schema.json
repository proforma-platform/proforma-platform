{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proforma.net.br/schemas/ccp/ccp-report.schema.json",
  "title": "CCP Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["ccp_ver", "id", "ts", "head_sha", "files_modified", "security"],
  "properties": {
    "ccp_ver": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "id": { "type": "string", "minLength": 1 },
    "ts": { "type": "string", "format": "date-time" },
    "head_sha": { "type": "string", "minLength": 7 },
    "repo_key": { "type": "string" },
    "agent_id": { "type": "string" },
    "branch": { "type": "string" },
    "files_modified": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string" },
          "status": { "type": "string", "enum": ["pass", "fail", "skip"] },
          "http": { "type": "integer" },
          "evidence": { "type": "string" }
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secret_scan", "assertion"],
      "properties": {
        "secret_scan": { "type": "string", "enum": ["pass", "fail"] },
        "assertion": { "type": "string" }
      }
    },
    "mod": {
      "type": "array",
      "items": { "type": "string" }
    },
    "res": { "type": "object" }
  },
  "patternProperties": {
    "^x_": {}
  }
}
